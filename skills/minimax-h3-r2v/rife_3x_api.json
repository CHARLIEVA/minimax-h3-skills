{
  "_meta": {
    "title": "H3 recast RIFE 3x (load the 24fps mp4 first)"
  },
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "REPLACE_24FPS.mp4"
    }
  },
  "2": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "1",
        0
      ]
    }
  },
  "3": {
    "class_type": "FrameInterpolationModelLoader",
    "inputs": {
      "model_name": "rife_v4.26.safetensors"
    }
  },
  "4": {
    "class_type": "FrameInterpolate",
    "inputs": {
      "interp_model": [
        "3",
        0
      ],
      "images": [
        "2",
        0
      ],
      "multiplier": 3
    }
  },
  "5": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "audio": [
        "2",
        1
      ],
      "fps": 72,
      "bit_depth": 8
    }
  },
  "6": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "5",
        0
      ],
      "filename_prefix": "video/H3_R2V_72fps",
      "format": "auto",
      "codec": "auto"
    }
  }
}